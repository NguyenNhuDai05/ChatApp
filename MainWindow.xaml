<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatClient"
        Title="Chat Client"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- EMOJI BUTTON STYLE -->

        <Style x:Key="EmojiButtonStyle"
               TargetType="Button">

            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>


            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F3F4F6"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid Margin="15"
          Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP -->

        <Border Grid.Row="0"
                Padding="15"
                CornerRadius="20"
                Background="White"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UsernameTextBox"
                         Margin="5"
                         Height="35"
                         FontSize="12"
                         Padding="10"
                         Background="#F5F7FB"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Text="dai"/>

                <TextBox x:Name="IpTextBox"
                         Grid.Column="1"
                         Margin="5"
                         Height="35"
                         FontSize="12"
                         Padding="10"
                         Background="#F5F7FB"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Text="127.0.0.1"/>

                <TextBox x:Name="PortTextBox"
                         Grid.Column="2"
                         Margin="5"
                         Height="35"
                         FontSize="12"
                         Padding="10"
                         Background="#F5F7FB"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Text="5000"/>

                <Button x:Name="ConnectButton"
                        Grid.Column="3"
                        Margin="5"
                        Height="35"
                        Content="Connect"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#5865F2"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ConnectButton_Click"/>

                <Button x:Name="DisconnectButton"
                        Grid.Column="4"
                        Margin="5"
                        Height="35"
                        Content="Disconnect"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#EF4444"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="DisconnectButton_Click"/>

            </Grid>

        </Border>

        <!-- BODY -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- USERS -->

            <Border Grid.Column="0"
                    CornerRadius="20"
                    Background="White"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="ONLINE USERS"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#777"
                               Margin="0,0,0,15"/>

                    <ListBox x:Name="UsersListBox"
                             FontSize="16"
                             BorderThickness="0"
                             Background="Transparent">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal">

                                    <Ellipse Width="12"
                                             Height="12"
                                             Fill="#22C55E"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding}"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </StackPanel>

            </Border>

            <!-- CHAT -->

            <Border Grid.Column="2"
                    CornerRadius="20"
                    Background="White"
                    Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TITLE -->

                    <TextBlock Text="Messages Group Chat"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <!-- CHAT LIST -->

                    <ListBox x:Name="MessagesListBox"
                             Grid.Row="1"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Segoe UI Emoji"
                             HorizontalContentAlignment="Stretch">

                        <ListBox.ItemTemplate>

                            <DataTemplate DataType="{x:Type local:ChatMessage}">

                                <Grid Margin="5">

                                    <TextBlock x:Name="SystemMessage"
                                               Text="{Binding Message}"
                                               FontSize="13"
                                               Foreground="#888"
                                               HorizontalAlignment="Center"
                                               Visibility="Collapsed"/>

                                    <Grid x:Name="ChatContainer">

                                        <!-- RIGHT -->

                                        <Border x:Name="RightBubble"
                                                Background="#5865F2"
                                                Padding="12"
                                                MaxWidth="350"
                                                CornerRadius="18"
                                                HorizontalAlignment="Right"
                                                Visibility="Collapsed">

                                            <StackPanel>

                                                <TextBlock Text="{Binding Username}"
                                                           Foreground="White"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding Message}"
                                                           Foreground="White"
                                                           FontFamily="Segoe UI Emoji"
                                                           FontSize="16"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding Timestamp}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>

                                            </StackPanel>

                                        </Border>

                                        <!-- LEFT -->

                                        <Border x:Name="LeftBubble"
                                                Background="#ECECEC"
                                                Padding="12"
                                                MaxWidth="350"
                                                CornerRadius="18"
                                                HorizontalAlignment="Left">

                                            <StackPanel>

                                                <TextBlock Text="{Binding Username}"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding Message}"
                                                           FontFamily="Segoe UI Emoji"
                                                           FontSize="16"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding Timestamp}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                </Grid>

                                <DataTemplate.Triggers>

                                    <DataTrigger Binding="{Binding IsMine}"
                                                 Value="True">

                                        <Setter TargetName="LeftBubble"
                                                Property="Visibility"
                                                Value="Collapsed"/>

                                        <Setter TargetName="RightBubble"
                                                Property="Visibility"
                                                Value="Visible"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsSystem}"
                                                 Value="True">

                                        <Setter TargetName="ChatContainer"
                                                Property="Visibility"
                                                Value="Collapsed"/>

                                        <Setter TargetName="SystemMessage"
                                                Property="Visibility"
                                                Value="Visible"/>

                                    </DataTrigger>

                                </DataTemplate.Triggers>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- INPUT -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- MESSAGE -->

                        <TextBox x:Name="MessageTextBox"
             Grid.Column="0"
             Margin="0,0,10,0"
             Height="48"
             FontSize="16"
             FontFamily="Segoe UI Emoji"
             Padding="15,0"
             Background="#F5F7FB"
             BorderThickness="0"
             VerticalContentAlignment="Center"
             KeyDown="MessageTextBox_KeyDown"/>

                        <!-- EMOJI BUTTON -->

                        <Grid Grid.Column="1"
          Margin="0,0,10,0">

                            <Button x:Name="EmojiPickerButton"
                Width="48"
                Height="48"
                FontSize="24"
                FontFamily="Segoe UI Emoji"
                Content="😊"
                Background="#F5F7FB"
                BorderThickness="0"
                Cursor="Hand"
                Click="EmojiPickerButton_Click"/>

                            <!-- POPUP -->

                            <Popup x:Name="EmojiPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=EmojiPickerButton}"
               StaysOpen="False"
               AllowsTransparency="True">

                                <Border Background="White"
                    CornerRadius="18"
                    Padding="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                                    <WrapPanel Width="300">

                                        <Button Content="😀" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😁" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😂" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="🤣" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😊" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😍" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="🥰" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😘" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😎" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="🥳" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😭" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😡" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="🤔" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😴" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="❤️" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="💖" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="💕" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="👍" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="👎" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="👏" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="🙏" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="🔥" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="🎉" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="💯" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="✨" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😅" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😆" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="🤩" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="😇" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>
                                        <Button Content="👌" Click="EmojiButton_Click" Style="{StaticResource EmojiButtonStyle}"/>

                                    </WrapPanel>

                                </Border>

                            </Popup>

                        </Grid>

                        <!-- SEND -->

                        <Button Grid.Column="2"
            Height="48"
            Content="Send"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="White"
            Background="#5865F2"
            BorderThickness="0"
            Cursor="Hand"
            Click="SendButton_Click"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>

